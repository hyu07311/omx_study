><gazebo reference="rh_p12_rn_l2"><mu1>30.0</mu1><mu2>30.0</mu2><kp>1000000.0</kp><kd>100.0</kd><minDepth>0.001</minDepth><maxVel>1.0</maxVel><material>Gazebo/DarkGrey</material></gazebo><gazebo reference="rh_r1_joint"><implicitSpringDamper>true</implicitSpringDamper></gazebo><gazebo reference="rh_r2"><implicitSpringDamper>true</implicitSpringDamper></gazebo><gazebo reference="rh_l1"><implicitSpringDamper>true</implicitSpringDamper></gazebo><gazebo reference="rh_l2"><implicitSpringDamper>true</implicitSpringDamper></gazebo><gazebo reference="camera_link"><material>Gazebo/Grey</material><sensor name="camera_d405" type="depth"><always_on>true</always_on><update_rate>15</update_rate><visualize>false</visualize><camera name="camera"><horizontal_fov>1.5184364492350666</horizontal_fov><image><width>848</width><height>480</height><format>R8G8B8</format></image><clip><near>0.07</near><far>3.0</far></clip></camera><plugin filename="libgazebo_ros_camera.so" name="camera_d405_driver"><ros><namespace>d405</namespace></ros><camera_name>color</camera_name><frame_name>camera_depth_optical_frame</frame_name><hack_baseline>0.0</hack_baseline><min_depth>0.07</min_depth><max_depth>0.5</max_depth></plugin></sensor></gazebo><!--
        그리퍼 링크 기구 재현 - 구동 관절 rh_r1_joint 의 실제 각도에 나머지 3개를 맞춤
          rh_l1        - 왼쪽 손가락이 오른쪽과 대칭으로 움직임
          rh_r2, rh_l2 - 손끝 마디가 항상 평행
      --><gazebo><plugin filename="libparallel_finger_plugin.so" name="parallel_finger"><pair><joint>rh_l1</joint><follow>rh_r1_joint</follow><multiplier>1</multiplier></pair><pair><joint>rh_r2</joint><follow>rh_r1_joint</follow><multiplier>1</multiplier></pair><pair><joint>rh_l2</joint><follow>rh_r1_joint</follow><multiplier>1</multiplier></pair></plugin></gazebo><gazebo><plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control"><parameters></parameters></plugin></gazebo></robot>