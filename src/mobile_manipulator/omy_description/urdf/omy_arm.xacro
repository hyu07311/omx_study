<?xml version="1.0"?>
<!--
  OMY 6축 팔 (link0 ~ link6, joint1 ~ joint6)
    관절 위치    - OMY-F3M 치수 도면 기준
    형상         - ROBOTIS 제공 CAD STL (mm 단위라 scale 0.001)
    질량, COG, 관성 - ROBOTIS 제공 CAD 실측값
    충돌 형상    - 각 STL 의 바운딩 박스 (직접 계산)
    관절 한계    - 사양서 (joint3 ±150°, 나머지 ±360°), 토크와 속도는 DYNAMIXEL-Y 데이터시트
  0 자세 = 팔이 위로 곧게 선 자세, 플랜지는 link6 의 -y 쪽
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== 치수 (단위 - m) ===================== -->
  <xacro:property name="omy_shoulder_height"  value="0.1715"/>  <!-- 바닥 ~ joint1 -->
  <xacro:property name="omy_shoulder_offset"  value="0.1215"/>  <!-- joint1 ~ joint2 (옆, -y) -->
  <xacro:property name="omy_upper_arm"        value="0.247"/>   <!-- joint2 ~ joint3 -->
  <xacro:property name="omy_forearm"          value="0.2195"/>  <!-- joint3 ~ joint4 -->
  <xacro:property name="omy_elbow_offset"     value="0.1215"/>  <!-- joint3 ~ joint4 (옆, +y) -->
  <xacro:property name="omy_wrist1_offset"    value="0.113"/>   <!-- joint4 ~ joint5 (옆, -y) -->
  <xacro:property name="omy_wrist2_length"    value="0.1155"/>  <!-- joint5 ~ joint6 -->
  <xacro:property name="omy_flange_offset"    value="0.103"/>   <!-- joint6 ~ 플랜지 (옆, -y) -->

  <!-- ===================== 구동기 (DYNAMIXEL-Y 데이터시트) ===================== -->
  <!-- YM080-230-A099-RH (joint1, 2) - 최대 토크 61.4 Nm, 무부하 32.2 rpm -->
  <xacro:property name="ym080_effort"   value="61.4"/>
  <xacro:property name="ym080_velocity" value="${32.2 * 2 * pi / 60}"/>
  <!-- YM070-210-A099-RH (joint3 ~ 6) - 최대 토크 31.7 Nm, 무부하 57.3 rpm -->
  <xacro:property name="ym070_effort"   value="31.7"/>
  <xacro:property name="ym070_velocity" value="${57.3 * 2 * pi / 60}"/>

  <xacro:property name="joint3_limit" value="${radians(150)}"/>

  <material name="omy_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="omy_light"><color rgba="0.8 0.8 0.8 1.0"/></material>

  <!-- ===================== 매크로 ===================== -->
  <!-- 메시 형상 + 바운딩 박스 충돌 + CAD 관성 텐서 -->
  <xacro:macro name="omy_link" params="name mesh material:=omy_grey
                                       box_xyz box_size
                                       mass com ixx ixy ixz iyy iyz izz">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh}" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="${box_xyz}" rpy="0 0 0"/>
        <geometry>
          <box size="${box_size}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${com}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="omy_joint" params="name parent child xyz axis limit effort velocity damping:=0.1">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="${axis}"/>
      <limit lower="${-limit}" upper="${limit}" effort="${effort}" velocity="${velocity}"/>
      <dynamics damping="${damping}"/>
    </joint>
  </xacro:macro>

  <!-- ===================== 팔 ===================== -->
  <!-- variant = f3m (카메라 브래킷이 달린 link6 + 플랜지) 또는 3m -->
  <xacro:macro name="omy_arm" params="variant">
    <xacro:property name="mesh_dir" value="package://omy_description/meshes/omy_f3m"/>

    <!-- 베이스 유닛 (바닥 고정) -->
    <link name="link0">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/base_unit.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="omy_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.057" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.085" length="0.114"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.0040216 0.0013084 0.0550735" rpy="0 0 0"/>
        <mass value="1.5287486"/>
        <inertia ixx="4.6428203e-03" ixy="4.4405532e-05" ixz="-1.5049296e-04"
                 iyy="4.9736955e-03" iyz="2.0756047e-05" izz="6.4078321e-03"/>
      </inertial>
    </link>

    <!-- 1축 - 몸통 회전 (z) -->
    <xacro:omy_joint name="joint1" parent="link0" child="link1"
                     xyz="0 0 ${omy_shoulder_height}" axis="0 0 1" limit="${2*pi}"
                     effort="${ym080_effort}" velocity="${ym080_velocity}" damping="0.05"/>
    <xacro:omy_link name="link1" mesh="${mesh_dir}/link1.stl"
                    box_xyz="0 -0.01025 0.00155" box_size="0.087 0.1075 0.1271"
                    mass="2.0648832" com="-0.0001106 -0.0054711 -0.0158977"
                    ixx="3.033219e-03" ixy="5.1792838e-06" ixz="3.3357961e-06"
                    iyy="2.7276724e-03" iyz="1.7934953e-04" izz="2.2826576e-03"/>

    <!-- 2축 - 어깨 (y) -->
    <xacro:omy_joint name="joint2" parent="link1" child="link2"
                     xyz="0 ${-omy_shoulder_offset} 0" axis="0 1 0" limit="${2*pi}"
                     effort="${ym080_effort}" velocity="${ym080_velocity}"/>
    <xacro:omy_link name="link2" mesh="${mesh_dir}/link2.stl" material="omy_light"
                    box_xyz="0 -0.00155 0.121" box_size="0.087 0.1271 0.329"
                    mass="3.6795395" com="0.0000114 0.0161842 0.1036063"
                    ixx="5.1731918e-02" ixy="2.3958819e-06" ixz="5.789396e-05"
                    iyy="5.0353401e-02" iyz="-4.3825716e-04" izz="4.501436e-03"/>

    <!-- 3축 - 팔꿈치 (y), 유일하게 ±150° 로 제한 -->
    <xacro:omy_joint name="joint3" parent="link2" child="link3"
                     xyz="0 0 ${omy_upper_arm}" axis="0 1 0" limit="${joint3_limit}"
                     effort="${ym070_effort}" velocity="${ym070_velocity}"/>
    <xacro:omy_link name="link3" mesh="${mesh_dir}/link3.stl" material="omy_light"
                    box_xyz="0 0.1182 0.10975" box_size="0.077 0.1224 0.2965"
                    mass="2.3865916" com="0.0000781 0.1071848 0.1411727"
                    ixx="2.2694399e-02" ixy="-9.4142428e-07" ixz="-1.8551757e-05"
                    iyy="2.1920087e-02" iyz="1.9179387e-04" izz="2.7761559e-03"/>

    <!-- 4축 - 손목 1 (y) -->
    <xacro:omy_joint name="joint4" parent="link3" child="link4"
                     xyz="0 ${omy_elbow_offset} ${omy_forearm}" axis="0 1 0" limit="${2*pi}"
                     effort="${ym070_effort}" velocity="${ym070_velocity}"/>
    <xacro:omy_link name="link4" mesh="${mesh_dir}/link4.stl"
                    box_xyz="0 -0.103 0.0033" box_size="0.077 0.097 0.1174"
                    mass="1.4002347" com="-0.0001332 -0.1074667 0.0190907"
                    ixx="1.7545679e-03" ixy="-4.5863379e-06" ixz="-1.7759142e-06"
                    iyy="1.5652147e-03" iyz="1.5339913e-04" izz="1.2159839e-03"/>

    <!-- 5축 - 손목 2 (z) -->
    <xacro:omy_joint name="joint5" parent="link4" child="link5"
                     xyz="0 ${-omy_wrist1_offset} 0" axis="0 0 1" limit="${2*pi}"
                     effort="${ym070_effort}" velocity="${ym070_velocity}"/>
    <xacro:omy_link name="link5" mesh="${mesh_dir}/link5.stl"
                    box_xyz="0 -0.0033 0.1055" box_size="0.077 0.1174 0.097"
                    mass="1.4002347" com="0.0001332 -0.0190907 0.1099667"
                    ixx="1.7545679e-03" ixy="-1.7759143e-06" ixz="-4.5863376e-06"
                    iyy="1.2159839e-03" iyz="1.5339913e-04" izz="1.5652147e-03"/>

    <!-- 6축 - 손목 3 (y) -->
    <xacro:omy_joint name="joint6" parent="link5" child="link6"
                     xyz="0 0 ${omy_wrist2_length}" axis="0 1 0" limit="${2*pi}"
                     effort="${ym070_effort}" velocity="${ym070_velocity}"/>
    <xacro:if value="${variant == 'f3m'}">
      <!-- F3M 의 link6 메시에는 카메라 브래킷이 포함되어 있음 (위쪽으로 0.104 m 까지) -->
      <xacro:omy_link name="link6" mesh="${mesh_dir}/link6.stl"
                      box_xyz="-0.0024 -0.08 0.03325" box_size="0.0798 0.046 0.1415"
                      mass="0.4001548" com="0.0000111 -0.0805941 0.0093029"
                      ixx="5.6741276e-04" ixy="2.0073339e-07" ixz="-1.2345347e-06"
                      iyy="6.2966706e-04" iyz="-5.6318805e-05" izz="1.9890515e-04"/>

      <!-- 그리퍼 장착 플랜지 -->
      <joint name="end_effector_flange_joint" type="fixed">
        <parent link="link6"/>
        <child link="end_effector_flange_link"/>
        <origin xyz="0 ${-omy_flange_offset} 0" rpy="0 0 0"/>
      </joint>
      <xacro:omy_link name="end_effector_flange_link" mesh="${mesh_dir}/flange.stl"
                      box_xyz="0 -0.00575 0" box_size="0.048 0.0115 0.042"
                      mass="0.0166188" com="0 -0.0031903 0"
                      ixx="2.9075758e-06" ixy="0" ixz="0"
                      iyy="8.1254311e-06" iyz="0" izz="5.4926181e-06"/>
    </xacro:if>
    <xacro:if value="${variant == '3m'}">
      <xacro:omy_link name="link6" mesh="package://omy_description/meshes/omy_3m/link6.stl"
                      box_xyz="-0.0024 -0.08 0" box_size="0.0798 0.046 0.075"
                      mass="0.3244269" com="0.0000111 -0.0805941 0.0093029"
                      ixx="1.9398849e-04" ixy="2.1420132e-07" ixz="-1.2342019e-06"
                      iyy="2.491307e-04" iyz="-3.8937348e-06" izz="1.6536751e-04"/>
    </xacro:if>
  </xacro:macro>

</robot>
