<?xml version="1.0"?>
<!-- 차동구동 모바일 베이스 - base_footprint - base_link - 좌우 바퀴 + 캐스터 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wheel" params="side y_sign">
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="${wheel_x} ${y_sign * wheel_y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="10" velocity="20"/>
      <dynamics damping="0.01"/>
    </joint>

    <link name="${side}_wheel_link">
      <!-- 원기둥은 기본이 z축 방향이므로 x축으로 90도 돌려 y축 방향으로 눕힘 -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </xacro:cylinder_inertia>
    </link>
  </xacro:macro>

  <xacro:macro name="mobile_base">
    <!-- 지면 위 로봇 기준 좌표 (diff_drive_controller의 base_frame_id) -->
    <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <!-- base_link 원점은 바퀴 축 높이, 몸체는 그 위로 base_height 만큼 -->
    <link name="base_link">
      <visual>
        <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}">
        <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      </xacro:box_inertia>
    </link>

    <xacro:wheel side="left"  y_sign="1"/>
    <xacro:wheel side="right" y_sign="-1"/>

    <!-- 앞쪽 캐스터 - 몸체 바닥(z=0)에서 지면(z=-wheel_radius)까지 닿도록 -->
    <joint name="caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_link"/>
      <origin xyz="${caster_x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
    </joint>

    <link name="caster_link">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:sphere_inertia>
    </link>
  </xacro:macro>

</robot>
