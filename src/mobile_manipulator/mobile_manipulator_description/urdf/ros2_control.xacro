<?xml version="1.0"?>
<!--
  ros2_control 하드웨어 인터페이스 정의
    use_sim=true  : Gazebo (gazebo_ros2_control/GazeboSystem)
    use_sim=false : 명령을 그대로 상태로 돌려주는 가짜 하드웨어 (RViz 단독 테스트용)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="position_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="velocity_joint" params="name">
    <joint name="${name}">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="mobile_manipulator_ros2_control" params="use_sim">
    <ros2_control name="MobileManipulatorSystem" type="system">
      <hardware>
        <xacro:if value="${use_sim}">
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_sim}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:unless>
      </hardware>

      <!-- 바퀴 - 속도 명령 (diff_drive_controller) -->
      <xacro:velocity_joint name="left_wheel_joint"/>
      <xacro:velocity_joint name="right_wheel_joint"/>

      <!-- SCARA 팔 - 위치 명령 (joint_trajectory_controller) -->
      <xacro:position_joint name="joint1"/>
      <xacro:position_joint name="joint2"/>
      <xacro:position_joint name="joint3"/>
      <xacro:position_joint name="joint4"/>

      <!-- 그리퍼 - 위치 명령 (gripper_action_controller), right는 left를 따라감 -->
      <xacro:position_joint name="gripper_left_joint"/>
      <joint name="gripper_right_joint">
        <param name="mimic">gripper_left_joint</param>
        <param name="multiplier">1</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>

</robot>
