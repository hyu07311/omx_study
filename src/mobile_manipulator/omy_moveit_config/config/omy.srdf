<?xml version="1.0" encoding="UTF-8"?>
<!-- OMY-F3M SRDF (Setup Assistant 와 같은 구성, 충돌 행렬은 collisions_updater 로 생성) -->
<robot name="omy">
  <group name="arm">
    <chain base_link="link0" tip_link="end_effector_link"/>
  </group>
  <!-- rh_r2, rh_l1, rh_l2 는 URDF mimic 으로 rh_r1_joint 를 따라감 -->
  <group name="gripper">
    <joint name="rh_r1_joint"/>
  </group>

  <!-- omy_ik_demo.py READY_POSE -->
  <group_state name="ready" group="arm">
    <joint name="joint1" value="0.286"/>
    <joint name="joint2" value="0.454"/>
    <joint name="joint3" value="0.361"/>
    <joint name="joint4" value="0.755"/>
    <joint name="joint5" value="1.571"/>
    <joint name="joint6" value="-1.857"/>
  </group_state>
  <group_state name="zero" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="rh_r1_joint" value="0"/>
  </group_state>
  <group_state name="close" group="gripper">
    <joint name="rh_r1_joint" value="1.1"/>
  </group_state>

  <end_effector name="gripper" parent_link="end_effector_flange_link" group="gripper" parent_group="arm"/>
  <!-- self-collision matrix: scripts/gen_collision_matrix.py, trials 10000, disable rh_p12_rn_l1:rh_p12_rn_r1 rh_p12_rn_l1:rh_p12_rn_r2 rh_p12_rn_l2:rh_p12_rn_r1 rh_p12_rn_l2:rh_p12_rn_r2 -->
  <disable_collisions link1="camera_link" link2="end_effector_flange_link" reason="Never"/>
  <disable_collisions link1="camera_link" link2="link5" reason="Never"/>
  <disable_collisions link1="camera_link" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="rh_p12_rn_base" reason="Never"/>
  <disable_collisions link1="camera_link" link2="rh_p12_rn_l1" reason="Never"/>
  <disable_collisions link1="camera_link" link2="rh_p12_rn_l2" reason="Never"/>
  <disable_collisions link1="camera_link" link2="rh_p12_rn_r1" reason="Never"/>
  <disable_collisions link1="camera_link" link2="rh_p12_rn_r2" reason="Never"/>
  <disable_collisions link1="end_effector_flange_link" link2="link4" reason="Never"/>
  <disable_collisions link1="end_effector_flange_link" link2="link5" reason="Never"/>
  <disable_collisions link1="end_effector_flange_link" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="end_effector_flange_link" link2="rh_p12_rn_base" reason="Adjacent"/>
  <disable_collisions link1="end_effector_flange_link" link2="rh_p12_rn_l1" reason="Never"/>
  <disable_collisions link1="end_effector_flange_link" link2="rh_p12_rn_l2" reason="Never"/>
  <disable_collisions link1="end_effector_flange_link" link2="rh_p12_rn_r1" reason="Never"/>
  <disable_collisions link1="end_effector_flange_link" link2="rh_p12_rn_r2" reason="Never"/>
  <disable_collisions link1="link0" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link3" reason="Never"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="rh_p12_rn_base" reason="Never"/>
  <disable_collisions link1="link4" link2="rh_p12_rn_l1" reason="Never"/>
  <disable_collisions link1="link4" link2="rh_p12_rn_l2" reason="Never"/>
  <disable_collisions link1="link4" link2="rh_p12_rn_r1" reason="Never"/>
  <disable_collisions link1="link4" link2="rh_p12_rn_r2" reason="Never"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="rh_p12_rn_base" reason="Never"/>
  <disable_collisions link1="link5" link2="rh_p12_rn_l1" reason="Never"/>
  <disable_collisions link1="link5" link2="rh_p12_rn_l2" reason="Never"/>
  <disable_collisions link1="link5" link2="rh_p12_rn_r1" reason="Never"/>
  <disable_collisions link1="link5" link2="rh_p12_rn_r2" reason="Never"/>
  <disable_collisions link1="link6" link2="rh_p12_rn_base" reason="Never"/>
  <disable_collisions link1="link6" link2="rh_p12_rn_l1" reason="Never"/>
  <disable_collisions link1="link6" link2="rh_p12_rn_l2" reason="Never"/>
  <disable_collisions link1="link6" link2="rh_p12_rn_r1" reason="Never"/>
  <disable_collisions link1="link6" link2="rh_p12_rn_r2" reason="Never"/>
  <disable_collisions link1="rh_p12_rn_base" link2="rh_p12_rn_l1" reason="Adjacent"/>
  <disable_collisions link1="rh_p12_rn_base" link2="rh_p12_rn_l2" reason="Never"/>
  <disable_collisions link1="rh_p12_rn_base" link2="rh_p12_rn_r1" reason="Adjacent"/>
  <disable_collisions link1="rh_p12_rn_base" link2="rh_p12_rn_r2" reason="Never"/>
  <disable_collisions link1="rh_p12_rn_l1" link2="rh_p12_rn_l2" reason="Adjacent"/>
  <disable_collisions link1="rh_p12_rn_l1" link2="rh_p12_rn_r1" reason="User"/>
  <disable_collisions link1="rh_p12_rn_l1" link2="rh_p12_rn_r2" reason="User"/>
  <disable_collisions link1="rh_p12_rn_l2" link2="rh_p12_rn_r1" reason="User"/>
  <disable_collisions link1="rh_p12_rn_l2" link2="rh_p12_rn_r2" reason="User"/>
  <disable_collisions link1="rh_p12_rn_r1" link2="rh_p12_rn_r2" reason="Adjacent"/>
</robot>
